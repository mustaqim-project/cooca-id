# ──────────────────────────────────────────────────────────
# APP CONFIGURATION
# ──────────────────────────────────────────────────────────
APP_NAME="Cooca.id"
APP_ENV=local
APP_KEY=base64:k4y64H5dYbenttF53am9JfUxshvOdY3XpOPHiHWFu+w=
APP_DEBUG=true # WAJIB false di production
# APP_URL=https://cooca.id
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=daily

# ──────────────────────────────────────────────────────────
# DATABASE (MySQL Optimized)
# ──────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cooca_id
DB_USERNAME=root
DB_PASSWORD=root

# ──────────────────────────────────────────────────────────
# CACHE & SESSION (DB Driver untuk Shared Hosting)
# ──────────────────────────────────────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ──────────────────────────────────────────────────────────
# QUEUE (Database Driver)
# ──────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ──────────────────────────────────────────────────────────
# MAIL (4 Addresses Strategy)
# ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io # Ganti dengan SMTP provider asli (e.g., Mailgun, SES)
MAIL_PORT=587
MAIL_USERNAME=your_smtp_user
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cooca.id"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────
# EXTERNAL SERVICES
# ──────────────────────────────────────────────────────────
# Midtrans
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_IS_PRODUCTION=false

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/customer/auth/google/callback"

# Fonnte WhatsApp
FONNTE_API_KEY=your_fonnte_api_key
FONNTE_API_URL=https://api.fonnte.com/send

# ──────────────────────────────────────────────────────────
# FASE 3: BACKUP & RECOVERY (spatie/laravel-backup)
# ──────────────────────────────────────────────────────────
# Primary backup destination: 'local' (development) or 'backup-s3' (production)
BACKUP_DISK_PRIMARY=local
# Secondary backup destination (optional, leave empty for single destination)
BACKUP_DISK_SECONDARY=

# S3 credentials for backup (can use same as AWS_ vars if same bucket, or separate)
BACKUP_S3_BUCKET=cooca-id-backups
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_DEFAULT_REGION=ap-southeast-1

# Backup retention
BACKUP_KEEP_ALL_DAYS=7

# Backup security
BACKUP_ARCHIVE_PASSWORD=      # Generate with: openssl rand -base64 32
BACKUP_VERIFY=true

# Backup notifications
BACKUP_NOTIFY_EMAIL=admin@cooca.id

# ──────────────────────────────────────────────────────────
# FASE 3: ERROR TRACKING (Sentry)
# ──────────────────────────────────────────────────────────
# Get your DSN from https://sentry.io after creating a project
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1   # 10% of transactions in production
SENTRY_ENVIRONMENT="${APP_ENV}"

# ──────────────────────────────────────────────────────────
# FASE 3: LOGGING (Custom channels)
# ──────────────────────────────────────────────────────────
LOG_PAYMENT_LEVEL=debug
LOG_PAYMENT_DAYS=30
LOG_ACTIVITY_LEVEL=info
LOG_ACTIVITY_DAYS=90
LOG_SECURITY_LEVEL=warning
LOG_SECURITY_DAYS=90
