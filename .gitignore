```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/

# Dependencies
vendor/
composer.lock

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*

# Editors
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Laravel specific
bootstrap/cache/
storage/logs/
storage/framework/
public/storage/

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE
.nyc_output/
```