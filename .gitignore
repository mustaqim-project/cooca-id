# =========================
# Production-safe Laravel .gitignore
# =========================

# Dependencies
/vendor/
node_modules/
composer.lock
package-lock.json
pnpm-lock.yaml
yarn.lock

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*
!.env.example
!.env.testing

# Laravel framework output
/storage/*.key
/storage/app/*
!storage/app/.gitkeep
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php
/public/storage
/public/hot
/public/build

# Build / compiled assets
/dist/
build/
coverage/
.nyc_output/
*.map
*.tsbuildinfo

# Cache and temp files
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.tmp/
.tmp/**

# Testing / QA artifacts
phpunit.xml.dist
.phpunit.result.cache
.phpunit.cache
coverage.xml
htmlcov/
.phpunit.*
.coverage
.coverage.*
.mypy_cache/
.pytest_cache/
.hypothesis/

# IDE and editor files
.vscode/
.idea/
*.code-workspace

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Binary / compiled junk
*.o
*.obj
*.out
*.class
*.so
*.a
*.dll
*.exe

# Other tool caches
.gradle/
target/
.zig-cache/
zig-cache/
.jest/
.parcel-cache/
.next/
.nuxt/
.vuepress/dist
.storybook-static/
.vercel/
.netlify/

# Local DB / runtime artifacts
*.sqlite
*.sqlite-journal
*.db

